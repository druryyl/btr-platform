<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ======================================================== -->
    <!-- SLATE NEUTRALS                                            -->
    <!-- ======================================================== -->
    <Color x:Key="Color.Slate.900">#0F172A</Color>
    <Color x:Key="Color.Slate.850">#18212F</Color>
    <Color x:Key="Color.Slate.800">#1E293B</Color>
    <Color x:Key="Color.Slate.700">#334155</Color>
    <Color x:Key="Color.Slate.600">#475569</Color>
    <Color x:Key="Color.Slate.500">#64748B</Color>
    <Color x:Key="Color.Slate.400">#94A3B8</Color>
    <Color x:Key="Color.Slate.300">#CBD5E1</Color>
    <Color x:Key="Color.Slate.200">#E2E8F0</Color>
    <Color x:Key="Color.Slate.100">#F1F5F9</Color>
    <Color x:Key="Color.Slate.50">#F8FAFC</Color>
    <Color x:Key="Color.White">#FFFFFF</Color>

    <SolidColorBrush x:Key="Brush.Slate.900" Color="{StaticResource Color.Slate.900}" />
    <SolidColorBrush x:Key="Brush.Slate.850" Color="{StaticResource Color.Slate.850}" />
    <SolidColorBrush x:Key="Brush.Slate.800" Color="{StaticResource Color.Slate.800}" />
    <SolidColorBrush x:Key="Brush.Slate.700" Color="{StaticResource Color.Slate.700}" />
    <SolidColorBrush x:Key="Brush.Slate.600" Color="{StaticResource Color.Slate.600}" />
    <SolidColorBrush x:Key="Brush.Slate.500" Color="{StaticResource Color.Slate.500}" />
    <SolidColorBrush x:Key="Brush.Slate.400" Color="{StaticResource Color.Slate.400}" />
    <SolidColorBrush x:Key="Brush.Slate.300" Color="{StaticResource Color.Slate.300}" />
    <SolidColorBrush x:Key="Brush.Slate.200" Color="{StaticResource Color.Slate.200}" />
    <SolidColorBrush x:Key="Brush.Slate.100" Color="{StaticResource Color.Slate.100}" />
    <SolidColorBrush x:Key="Brush.Slate.50"  Color="{StaticResource Color.Slate.50}" />
    <SolidColorBrush x:Key="Brush.White"     Color="{StaticResource Color.White}" />

    <!-- ======================================================== -->
    <!-- PRIMARY BLUE (Action / Focus / Brand)                    -->
    <!-- ======================================================== -->
    <Color x:Key="Color.Blue.900">#1E3A8A</Color>
    <Color x:Key="Color.Blue.800">#1E40AF</Color>
    <Color x:Key="Color.Blue.700">#1D4ED8</Color>
    <Color x:Key="Color.Blue.600">#2563EB</Color>
    <Color x:Key="Color.Blue.500">#3B82F6</Color>
    <Color x:Key="Color.Blue.200">#BFDBFE</Color>
    <Color x:Key="Color.Blue.50">#EFF6FF</Color>

    <SolidColorBrush x:Key="Brush.Primary"        Color="{StaticResource Color.Blue.600}" />
    <SolidColorBrush x:Key="Brush.Primary.Hover"  Color="{StaticResource Color.Blue.700}" />
    <SolidColorBrush x:Key="Brush.Primary.Active" Color="{StaticResource Color.Blue.800}" />
    <SolidColorBrush x:Key="Brush.Primary.Light"  Color="{StaticResource Color.Blue.50}" />
    <SolidColorBrush x:Key="Brush.Primary.Border" Color="{StaticResource Color.Blue.200}" />

    <!-- ======================================================== -->
    <!-- EMERALD (Success / Bagus / Synced)                       -->
    <!-- ======================================================== -->
    <Color x:Key="Color.Emerald.800">#065F46</Color>
    <Color x:Key="Color.Emerald.700">#047857</Color>
    <Color x:Key="Color.Emerald.600">#059669</Color>
    <Color x:Key="Color.Emerald.500">#10B981</Color>
    <Color x:Key="Color.Emerald.200">#A7F3D0</Color>
    <Color x:Key="Color.Emerald.50">#ECFDF5</Color>

    <SolidColorBrush x:Key="Brush.Success"        Color="{StaticResource Color.Emerald.500}" />
    <SolidColorBrush x:Key="Brush.Success.Hover"  Color="{StaticResource Color.Emerald.600}" />
    <SolidColorBrush x:Key="Brush.Success.Active" Color="{StaticResource Color.Emerald.700}" />
    <SolidColorBrush x:Key="Brush.Success.Light"  Color="{StaticResource Color.Emerald.50}" />
    <SolidColorBrush x:Key="Brush.Success.Border" Color="{StaticResource Color.Emerald.200}" />
    <SolidColorBrush x:Key="Brush.Success.Text"   Color="{StaticResource Color.Emerald.800}" />

    <!-- ======================================================== -->
    <!-- ROSE (Danger / Rusak / Locked)                           -->
    <!-- ======================================================== -->
    <Color x:Key="Color.Rose.800">#9F1239</Color>
    <Color x:Key="Color.Rose.700">#BE123C</Color>
    <Color x:Key="Color.Rose.600">#E11D48</Color>
    <Color x:Key="Color.Rose.500">#F43F5E</Color>
    <Color x:Key="Color.Rose.200">#FECDD3</Color>
    <Color x:Key="Color.Rose.50">#FFF1F2</Color>

    <SolidColorBrush x:Key="Brush.Danger"        Color="{StaticResource Color.Rose.600}" />
    <SolidColorBrush x:Key="Brush.Danger.Hover"  Color="{StaticResource Color.Rose.700}" />
    <SolidColorBrush x:Key="Brush.Danger.Active" Color="{StaticResource Color.Rose.800}" />
    <SolidColorBrush x:Key="Brush.Danger.Light"  Color="{StaticResource Color.Rose.50}" />
    <SolidColorBrush x:Key="Brush.Danger.Border" Color="{StaticResource Color.Rose.200}" />
    <SolidColorBrush x:Key="Brush.Danger.Text"   Color="{StaticResource Color.Rose.800}" />

    <!-- ======================================================== -->
    <!-- AMBER (Warning / Draft / Fallback Search)                -->
    <!-- ======================================================== -->
    <Color x:Key="Color.Amber.800">#92400E</Color>
    <Color x:Key="Color.Amber.700">#B45309</Color>
    <Color x:Key="Color.Amber.600">#D97706</Color>
    <Color x:Key="Color.Amber.500">#F59E0B</Color>
    <Color x:Key="Color.Amber.200">#FDE68A</Color>
    <Color x:Key="Color.Amber.100">#FEF3C7</Color>

    <SolidColorBrush x:Key="Brush.Warning"        Color="{StaticResource Color.Amber.600}" />
    <SolidColorBrush x:Key="Brush.Warning.Hover"  Color="{StaticResource Color.Amber.700}" />
    <SolidColorBrush x:Key="Brush.Warning.Active" Color="{StaticResource Color.Amber.800}" />
    <SolidColorBrush x:Key="Brush.Warning.Light"  Color="{StaticResource Color.Amber.100}" />
    <SolidColorBrush x:Key="Brush.Warning.Border" Color="{StaticResource Color.Amber.200}" />
    <SolidColorBrush x:Key="Brush.Warning.Text"   Color="{StaticResource Color.Amber.800}" />

    <!-- ======================================================== -->
    <!-- SELECTION & FOCUS TOKENS                                 -->
    <!-- ======================================================== -->
    <Color x:Key="Color.Selection.Background">#E0E7FF</Color>
    <SolidColorBrush x:Key="Brush.Selection.Background" Color="{StaticResource Color.Selection.Background}" />
    <SolidColorBrush x:Key="Brush.Selection.Foreground" Color="{StaticResource Color.Slate.900}" />

    <!-- ======================================================== -->
    <!-- SEMANTIC UI ROLES                                        -->
    <!-- ======================================================== -->
    <SolidColorBrush x:Key="Brush.Window.Background"   Color="{StaticResource Color.Slate.100}" />
    <SolidColorBrush x:Key="Brush.Sidebar.Background"  Color="{StaticResource Color.Slate.850}" />
    <SolidColorBrush x:Key="Brush.Card.Background"     Color="{StaticResource Color.White}" />
    <SolidColorBrush x:Key="Brush.Card.DarkBackground" Color="{StaticResource Color.Slate.800}" />
    <SolidColorBrush x:Key="Brush.Card.Border"         Color="{StaticResource Color.Slate.200}" />
    <SolidColorBrush x:Key="Brush.Divider"             Color="{StaticResource Color.Slate.200}" />

    <SolidColorBrush x:Key="Brush.Text.Primary"        Color="{StaticResource Color.Slate.900}" />
    <SolidColorBrush x:Key="Brush.Text.Secondary"      Color="{StaticResource Color.Slate.600}" />
    <SolidColorBrush x:Key="Brush.Text.Muted"          Color="{StaticResource Color.Slate.400}" />
    <SolidColorBrush x:Key="Brush.Text.Subtle"         Color="{StaticResource Color.Slate.500}" />
    <SolidColorBrush x:Key="Brush.Text.Inverse"        Color="{StaticResource Color.White}" />

</ResourceDictionary>
