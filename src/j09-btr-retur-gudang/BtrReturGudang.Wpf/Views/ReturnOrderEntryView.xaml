<UserControl x:Class="BtrReturGudang.Wpf.Views.ReturnOrderEntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:BtrReturGudang.Wpf.ViewModels"
             xmlns:controls="clr-namespace:BtrReturGudang.Wpf.Controls"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:ReturnOrderEntryViewModel}"
             d:DesignHeight="650" d:DesignWidth="1050"
             Background="{DynamicResource Brush.Window.Background}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BtrReturGudang.Wpf;component/Themes/Colors.xaml" />
                <ResourceDictionary Source="/BtrReturGudang.Wpf;component/Themes/Styles.xaml" />
                <ResourceDictionary Source="/BtrReturGudang.Wpf;component/Themes/DataGrid.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Status Badge Style for Product Banner -->
            <Style x:Key="Badge.BannerStatus" TargetType="{x:Type Border}">
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Background" Value="#14231E" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBannerError}" Value="True">
                    <Setter Property="Background" Value="#3B1219" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Text.BannerStatus" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBannerError}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Product Banner Background Style -->
        <Style x:Key="Banner.ProductPanel" TargetType="{x:Type Border}">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Background" Value="{DynamicResource Brush.Slate.900}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBannerError}" Value="True">
                    <Setter Property="Background" Value="#450A0A" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Grid Delete Action Button -->
        <Style x:Key="Button.GridDelete" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource Brush.Danger.Light}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Height" Value="24" />
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Master Layout Grid -->
    <Grid Margin="12,8,12,8">
        <Grid.RowDefinitions>
            <!-- Row 0: Compact Customer & Driver Header (~68px) -->
            <RowDefinition Height="Auto" />
            <!-- Row 1: Full-Width High-Contrast Product Banner (~56px) -->
            <RowDefinition Height="Auto" />
            <!-- Row 2: Spacious Quantity Strip (~64px) -->
            <RowDefinition Height="Auto" />
            <!-- Row 3: Live Items Grid (Expands to fit remaining space) -->
            <RowDefinition Height="*" />
            <!-- Row 4: Summary Footer (~34px) -->
            <RowDefinition Height="Auto" />
            <!-- Row 5: Action Toolbar (~42px) -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ======================================================== -->
        <!-- ROW 0: COMPACT CUSTOMER & DRIVER HEADER                   -->
        <!-- Traceable to: ARCHITECTURE §4 TD-013, §5.2 SCR-02         -->
        <!-- ======================================================== -->
        <Border Grid.Row="0"
                Background="{DynamicResource Brush.White}"
                BorderBrush="{DynamicResource Brush.Slate.200}"
                BorderThickness="1" CornerRadius="4"
                Padding="10,6" Margin="0,0,0,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="4" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="75" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" MinWidth="75" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Row 0 Left: Customer Autocomplete & Search -->
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="Customer:" Style="{StaticResource Text.Label}"
                           VerticalAlignment="Center" Margin="0,0,6,0" />
                <Grid Grid.Row="0" Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             x:Name="TxtCustomer"
                             Text="{Binding CustomerInputText, UpdateSourceTrigger=PropertyChanged}"
                             Height="30" VerticalContentAlignment="Center"
                             ToolTip="Ketik nama/kode customer atau tekan [F8] untuk cari manual" />
                    <Button Grid.Column="1"
                            x:Name="BtnSearchCustomer"
                            Content="🔍 Cari [F8]"
                            Command="{Binding CustomerSearchCommand}"
                            Height="30" Margin="4,0,0,0" Padding="8,0"
                            FontSize="11.5"
                            Style="{StaticResource Button.Primary}" />
                </Grid>

                <!-- Row 0 Right: Driver -->
                <TextBlock Grid.Row="0" Grid.Column="3"
                           Text="Driver:" Style="{StaticResource Text.Label}"
                           VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox Grid.Row="0" Grid.Column="4"
                          x:Name="CboDriver"
                          ItemsSource="{Binding Drivers}"
                          SelectedItem="{Binding SelectedDriver}"
                          Height="30" VerticalContentAlignment="Center" />

                <!-- Row 2 Left: Salesman -->
                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="Salesman:" Style="{StaticResource Text.Label}"
                           VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox Grid.Row="2" Grid.Column="1"
                          x:Name="CboSalesPerson"
                          ItemsSource="{Binding SalesPersons}"
                          SelectedItem="{Binding SelectedSalesPerson}"
                          Height="30" VerticalContentAlignment="Center" />

                <!-- Row 2 Right: Catatan Retur -->
                <TextBlock Grid.Row="2" Grid.Column="3"
                           Text="Catatan Retur:" Style="{StaticResource Text.Label}"
                           VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Grid.Row="2" Grid.Column="4"
                         x:Name="TxtKeterangan"
                         Text="{Binding Keterangan, UpdateSourceTrigger=PropertyChanged}"
                         Height="30" VerticalContentAlignment="Center"
                         ToolTip="Catatan opsional untuk faktur/dokumen retur" />
            </Grid>
        </Border>

        <!-- ======================================================== -->
        <!-- ROW 1: FULL-WIDTH HIGH-CONTRAST PRODUCT BANNER            -->
        <!-- Pure BrgName in 14pt bold white text without code noise   -->
        <!-- Traceable to: ARCHITECTURE §4 TD-013, §5.2 SCR-02         -->
        <!-- ======================================================== -->
        <Border Grid.Row="1"
                x:Name="PnlProductBanner"
                Style="{StaticResource Banner.ProductPanel}"
                Margin="0,0,0,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Product Name: Pure BrgName in 14pt Bold White (Zero truncation on long FMCG names) -->
                <TextBlock Grid.Row="0" Grid.Column="0"
                           x:Name="TxtProductName"
                           Text="{Binding ProductName}"
                           FontSize="14" FontWeight="Bold"
                           Foreground="{DynamicResource Brush.White}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />

                <!-- Status Badge -->
                <Border Grid.Row="0" Grid.Column="1"
                        Style="{StaticResource Badge.BannerStatus}"
                        Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtBannerStatus"
                               Text="{Binding BannerStatus}"
                               Style="{StaticResource Text.BannerStatus}" />
                </Border>

                <!-- Barcode & Packaging Details in Monospace -->
                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                           x:Name="TxtBarcodeDetails"
                           Text="{Binding BarcodeDetails}"
                           FontFamily="Consolas" FontSize="11.5"
                           Foreground="{DynamicResource Brush.Slate.400}"
                           VerticalAlignment="Center" Margin="0,3,0,0" />
            </Grid>
        </Border>

        <!-- ======================================================== -->
        <!-- ROW 2: SPACIOUS QUANTITY STRIP                           -->
        <!-- Satuan, Qty Bagus, Qty Rusak, Catatan Item, + Tambah     -->
        <!-- Traceable to: ARCHITECTURE §4 TD-013, §5.2 SCR-02         -->
        <!-- ======================================================== -->
        <Border Grid.Row="2"
                Background="{DynamicResource Brush.White}"
                BorderBrush="{DynamicResource Brush.Slate.200}"
                BorderThickness="1" CornerRadius="4"
                Padding="10,6" Margin="0,0,0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Satuan Dropdown (90px) -->
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="10" />
                    <!-- Qty Bagus (110px) -->
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="10" />
                    <!-- Qty Rusak (110px) -->
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="10" />
                    <!-- Catatan Item (Fills remaining) -->
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <!-- Action Button (+ Tambah [Enter]) (165px) -->
                    <ColumnDefinition Width="165" />
                </Grid.ColumnDefinitions>

                <!-- 1. Satuan -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Satuan" Style="{StaticResource Text.Label}" Margin="0,0,0,2" />
                    <ComboBox x:Name="CboSatuan"
                              ItemsSource="{Binding PackagingUnits}"
                              SelectedItem="{Binding SelectedSatuan}"
                              Height="34" VerticalContentAlignment="Center" />
                </StackPanel>

                <!-- 2. Qty Bagus (NumericTextBox with Green Accent) -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Qty Bagus" Style="{StaticResource Text.Label}"
                               Foreground="{DynamicResource Brush.Success.Text}" Margin="0,0,0,2" />
                    <controls:NumericTextBox x:Name="TxtQtyBagus"
                                             Value="{Binding QtyBagus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Minimum="0" Watermark="0"
                                             Height="34" FontWeight="Bold" FontSize="14"
                                             BorderBrush="{DynamicResource Brush.Success.Border}"
                                             ToolTip="Kuantitas barang kondisi layak jual (BAGUS)" />
                </StackPanel>

                <!-- 3. Qty Rusak (NumericTextBox with Red Accent) -->
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Qty Rusak" Style="{StaticResource Text.Label}"
                               Foreground="{DynamicResource Brush.Danger.Text}" Margin="0,0,0,2" />
                    <controls:NumericTextBox x:Name="TxtQtyRusak"
                                             Value="{Binding QtyRusak, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Minimum="0" Watermark="0"
                                             Height="34" FontWeight="Bold" FontSize="14"
                                             BorderBrush="{DynamicResource Brush.Danger.Border}"
                                             ToolTip="Kuantitas barang kondisi cacat / rusak (RUSAK)" />
                </StackPanel>

                <!-- 4. Catatan Item -->
                <StackPanel Grid.Column="6">
                    <TextBlock Text="Catatan Item (Opsional)" Style="{StaticResource Text.Label}" Margin="0,0,0,2" />
                    <TextBox x:Name="TxtItemNotes"
                             Text="{Binding ItemKeterangan, UpdateSourceTrigger=PropertyChanged}"
                             Height="34" VerticalContentAlignment="Center"
                             ToolTip="Keterangan kondisi fisik barang (contoh: bungkus sobek, kadaluarsa)" />
                </StackPanel>

                <!-- 5. + Tambah [Enter] Button (Never clipped, prominent caption) -->
                <StackPanel Grid.Column="8" VerticalAlignment="Bottom">
                    <Button x:Name="BtnAddItem"
                            Content="+ Tambah [Enter]"
                            Command="{Binding AddItemCommand}"
                            Height="34" MinWidth="150"
                            Style="{StaticResource Button.Primary}"
                            FontWeight="Bold" FontSize="13"
                            ToolTip="Tambahkan barang ke daftar transaksi intake retur [Enter]" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================================================== -->
        <!-- ROW 3: LIVE INTAKE DATAGRID                               -->
        <!-- Displays items committed from quantity strip in real-time -->
        <!-- Traceable to: ARCHITECTURE §4 TD-013, §5.2 SCR-02         -->
        <!-- ======================================================== -->
        <DataGrid Grid.Row="3"
                  x:Name="DgvItems"
                  ItemsSource="{Binding Items}"
                  SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow">
            <DataGrid.Columns>
                <!-- 1. No -->
                <DataGridTextColumn Header="No" Binding="{Binding NoUrut}" Width="45" />

                <!-- 2. Barcode -->
                <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="135" />

                <!-- 3. Nama Barang -->
                <DataGridTextColumn Header="Nama Barang" Binding="{Binding BrgName}" Width="*" />

                <!-- 4. Jenis Retur (Colored Badge) -->
                <DataGridTemplateColumn Header="Jenis Retur" Width="105">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="3" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="Background" Value="{DynamicResource Brush.Success.Light}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding JenisRetur}" Value="RUSAK">
                                                <Setter Property="Background" Value="{DynamicResource Brush.Danger.Light}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding JenisRetur}" FontWeight="Bold" FontSize="11">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Success.Text}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding JenisRetur}" Value="RUSAK">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger.Text}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- 5. Qty -->
                <DataGridTextColumn Header="Qty"
                                    Binding="{Binding Qty, StringFormat={}{0:N0}}"
                                    Width="80">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="HorizontalAlignment" Value="Right" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Margin" Value="0,0,10,0" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 6. Satuan -->
                <DataGridTextColumn Header="Satuan" Binding="{Binding SatId}" Width="75" />

                <!-- 7. Catatan Item -->
                <DataGridTextColumn Header="Catatan Item" Binding="{Binding Keterangan}" Width="180" />

                <!-- 8. Aksi (Hapus) -->
                <DataGridTemplateColumn Header="Aksi" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Hapus"
                                    Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource Button.GridDelete}"
                                    ToolTip="Hapus baris ini dari daftar retur" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ======================================================== -->
        <!-- ROW 4: SUMMARY FOOTER (Total Bagus, Total Rusak, Total)   -->
        <!-- Traceable to: ARCHITECTURE §4 TD-013, §5.2 SCR-02         -->
        <!-- ======================================================== -->
        <Border Grid.Row="4"
                Background="{DynamicResource Brush.Slate.850}"
                CornerRadius="0" Height="34" Padding="14,0" Margin="0,0,0,6">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Total Items -->
                <TextBlock Grid.Column="0"
                           x:Name="LblSummaryItems"
                           Text="{Binding TotalItemsSummaryText}"
                           Foreground="{DynamicResource Brush.White}"
                           FontWeight="Bold" FontSize="12"
                           VerticalAlignment="Center" Margin="0,0,28,0" />

                <!-- Total Qty Bagus -->
                <TextBlock Grid.Column="1"
                           x:Name="LblSummaryBagus"
                           Text="{Binding TotalQtyBagusText}"
                           Foreground="{DynamicResource Brush.Success}"
                           FontWeight="Bold" FontSize="12"
                           VerticalAlignment="Center" Margin="0,0,28,0" />

                <!-- Total Qty Rusak -->
                <TextBlock Grid.Column="2"
                           x:Name="LblSummaryRusak"
                           Text="{Binding TotalQtyRusakText}"
                           Foreground="#FB7185"
                           FontWeight="Bold" FontSize="12"
                           VerticalAlignment="Center" Margin="0,0,28,0" />

                <!-- Total Kuantitas -->
                <TextBlock Grid.Column="3"
                           x:Name="LblSummaryTotal"
                           Text="{Binding TotalKuantitasText}"
                           Foreground="#93C5FD"
                           FontWeight="Bold" FontSize="12"
                           VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
        </Border>

        <!-- ======================================================== -->
        <!-- ROW 5: ACTION TOOLBAR (F9, F10, Esc, F2)                  -->
        <!-- Traceable to: ARCHITECTURE §4 TD-011, TD-013, SCR-02      -->
        <!-- ======================================================== -->
        <Border Grid.Row="5" Height="40" Background="Transparent">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- F9 Simpan Draft -->
                <Button x:Name="BtnSaveDraft"
                        Content="[F9]  Simpan Draft"
                        Command="{Binding SaveDraftCommand}"
                        Width="150" Height="34" Margin="0,0,8,0"
                        Background="{DynamicResource Brush.Slate.700}"
                        Foreground="{DynamicResource Brush.White}"
                        ToolTip="Simpan dokumen retur ke database lokal btrgd sebagai Draft [F9]" />

                <!-- F10 Simpan & Upload -->
                <Button x:Name="BtnSaveAndUpload"
                        Content="[F10]  Simpan &amp; Upload"
                        Command="{Binding SaveAndUploadCommand}"
                        Width="175" Height="34" Margin="0,0,8,0"
                        Style="{StaticResource Button.Success}"
                        ToolTip="Simpan draft lokal dan langsung upload ke server Cloud [F10]" />

                <!-- Esc Reset Form -->
                <Button x:Name="BtnReset"
                        Content="[Esc]  Reset Form"
                        Command="{Binding ResetFormCommand}"
                        Width="140" Height="34" Margin="0,0,8,0"
                        Background="{DynamicResource Brush.White}"
                        Foreground="{DynamicResource Brush.Slate.700}"
                        BorderBrush="{DynamicResource Brush.Slate.300}"
                        BorderThickness="1"
                        ToolTip="Batalkan transaksi saat ini dan bersihkan form [Esc]" />

                <!-- F2 Cari Barang Manual -->
                <Button x:Name="BtnManualSearch"
                        Content="[F2]  Cari Barang"
                        Command="{Binding ManualSearchCommand}"
                        Width="145" Height="34"
                        Style="{StaticResource Button.Warning}"
                        ToolTip="Buka dialog pencarian produk manual [F2]" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
