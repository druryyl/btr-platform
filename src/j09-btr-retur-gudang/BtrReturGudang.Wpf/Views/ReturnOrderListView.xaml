<UserControl x:Class="BtrReturGudang.Wpf.Views.ReturnOrderListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:BtrReturGudang.Wpf.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:ReturnOrderListViewModel}"
             Background="{DynamicResource Brush.Window.Background}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BtrReturGudang.Wpf;component/Themes/Colors.xaml" />
                <ResourceDictionary Source="/BtrReturGudang.Wpf;component/Themes/Styles.xaml" />
                <ResourceDictionary Source="/BtrReturGudang.Wpf;component/Themes/DataGrid.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Row 0: Top Header (44px) -->
            <RowDefinition Height="44" />
            <!-- Row 1: Filter Bar (40px) -->
            <RowDefinition Height="40" />
            <!-- Row 2: Split Body (*) -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ======================================================== -->
        <!-- ROW 0: TOP HEADER (44px)                                  -->
        <!-- Traceable to: ARCHITECTURE §4 TD-013, §5.2 SCR-05        -->
        <!-- ======================================================== -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.White}"
                BorderBrush="{DynamicResource Brush.Slate.200}" BorderThickness="0,0,0,1"
                Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="📋 Daftar &amp; Riwayat Retur [F3]"
                               FontSize="13.5" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Slate.900}" />
                    <TextBlock Text="Riwayat fisik retur, verifikasi status sinkronisasi, dan inspeksi proteksi dokumen (Post-Sync Locking)."
                               FontSize="11" Foreground="{DynamicResource Brush.Slate.500}" Margin="0,1,0,0" />
                </StackPanel>

                <!-- Refresh Button -->
                <Button Grid.Column="1" Command="{Binding LoadOrdersCommand}"
                        Content="🔄 Muat Ulang"
                        Style="{StaticResource Button.Secondary}"
                        Height="28" MinHeight="28" Padding="12,2"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- ======================================================== -->
        <!-- ROW 1: FILTER BAR (40px)                                  -->
        <!-- Traceable to: ARCHITECTURE §4 TD-013, §5.2 SCR-05        -->
        <!-- ======================================================== -->
        <Border Grid.Row="1" Background="{DynamicResource Brush.Slate.50}"
                BorderBrush="{DynamicResource Brush.Slate.200}" BorderThickness="0,0,0,1"
                Padding="16,6">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Start Date -->
                <TextBlock Text="Dari Tanggal:" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Slate.700}"
                           VerticalAlignment="Center" Margin="0,0,6,0" />
                <DatePicker SelectedDate="{Binding StartDate, Mode=TwoWay}"
                            Width="110" Height="26" Margin="0,0,12,0"
                            VerticalAlignment="Center" />

                <!-- End Date -->
                <TextBlock Text="Sampai:" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Slate.700}"
                           VerticalAlignment="Center" Margin="0,0,6,0" />
                <DatePicker SelectedDate="{Binding EndDate, Mode=TwoWay}"
                            Width="110" Height="26" Margin="0,0,12,0"
                            VerticalAlignment="Center" />

                <!-- Status Filter -->
                <TextBlock Text="Status Sync:" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Slate.700}"
                           VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox ItemsSource="{Binding StatusFilterOptions}"
                          SelectedItem="{Binding SelectedStatusFilter, Mode=TwoWay}"
                          Width="120" Height="26" Margin="0,0,12,0"
                          VerticalAlignment="Center" />

                <!-- Apply Filter Button -->
                <Button Command="{Binding ApplyFilterCommand}"
                        Content="Terapkan Filter"
                        Style="{StaticResource Button.Primary}"
                        Height="26" MinHeight="26" Padding="12,2"
                        Margin="0,0,16,0" VerticalAlignment="Center" />

                <!-- Summary count label -->
                <TextBlock Text="{Binding SummaryCountText}"
                           FontSize="11.5" Foreground="{DynamicResource Brush.Slate.500}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- ======================================================== -->
        <!-- ROW 2: MASTER-DETAIL SPLIT BODY                          -->
        <!-- Proportional splitter: ~540px left / ~500px right on 720p-->
        <!-- ======================================================== -->
        <Grid Grid.Row="2" Margin="12,8">
            <Grid.ColumnDefinitions>
                <!-- Column 0: Left Panel (Master Orders Grid) -->
                <ColumnDefinition Width="540" MinWidth="380" />
                <!-- Column 1: GridSplitter -->
                <ColumnDefinition Width="8" />
                <!-- Column 2: Right Panel (Inspector Card) -->
                <ColumnDefinition Width="*" MinWidth="380" />
            </Grid.ColumnDefinitions>

            <!-- ======================================================== -->
            <!-- LEFT PANEL: RETURN ORDERS GRID CARD                      -->
            <!-- ======================================================== -->
            <Border Grid.Column="0"
                    Background="{DynamicResource Brush.Card.Background}"
                    BorderBrush="{DynamicResource Brush.Card.Border}"
                    BorderThickness="1" CornerRadius="6" Padding="8">
                <DataGrid x:Name="OrdersGrid"
                          ItemsSource="{Binding Orders}"
                          SelectedItem="{Binding SelectedOrder, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{DynamicResource Brush.Slate.200}"
                          BorderThickness="0"
                          Background="Transparent"
                          HeadersVisibility="Column"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="False">

                    <DataGrid.Columns>
                        <!-- ULID Document ID -->
                        <DataGridTextColumn Header="No. Dokumen (ULID)"
                                            Binding="{Binding ReturnOrderId}"
                                            FontFamily="Consolas"
                                            Width="165" />

                        <!-- Tanggal -->
                        <DataGridTextColumn Header="Tanggal"
                                            Binding="{Binding ReturnOrderDate, StringFormat=\{0:yyyy-MM-dd\}}"
                                            Width="85" />

                        <!-- Customer -->
                        <DataGridTextColumn Header="Customer"
                                            Binding="{Binding CustName}"
                                            Width="*" />

                        <!-- Total Qty -->
                        <DataGridTextColumn Header="Total Qty"
                                            Binding="{Binding TotalQty, StringFormat=\{0:N0\}}"
                                            FontWeight="Bold"
                                            Width="75">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="Padding" Value="0,0,8,0" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Status Sync Badge -->
                        <DataGridTemplateColumn Header="Status Sync" Width="105">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Padding="8,2"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="{x:Type Border}">
                                                <!-- Default: Draft (Amber) -->
                                                <Setter Property="Background" Value="{DynamicResource Brush.Warning.Light}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StatusSync}" Value="Synced">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.Success.Light}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StatusSync}" FontSize="11" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Warning.Text}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StatusSync}" Value="Synced">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Success.Text}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- ======================================================== -->
            <!-- GRID SPLITTER                                            -->
            <!-- ======================================================== -->
            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="{DynamicResource Brush.Slate.200}"
                          Cursor="SizeWE"
                          ShowsPreview="False" />

            <!-- ======================================================== -->
            <!-- RIGHT PANEL: INSPECTOR CARD & POST-SYNC LOCK             -->
            <!-- ======================================================== -->
            <Border Grid.Column="2"
                    Background="{DynamicResource Brush.Card.Background}"
                    BorderBrush="{DynamicResource Brush.Card.Border}"
                    BorderThickness="1" CornerRadius="6" Padding="12,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Title (24px) -->
                        <RowDefinition Height="Auto" />
                        <!-- Locked Banner (Auto) -->
                        <RowDefinition Height="Auto" />
                        <!-- Metadata Grid (Auto) -->
                        <RowDefinition Height="Auto" />
                        <!-- Items Header (Auto) -->
                        <RowDefinition Height="Auto" />
                        <!-- Detail Items Grid (*) -->
                        <RowDefinition Height="*" />
                        <!-- Action Buttons Bar (42px) -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 1. Inspector Title -->
                    <TextBlock Grid.Row="0" Text="📋 Detail &amp; Inspeksi Dokumen"
                               FontSize="13.5" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Slate.900}"
                               Margin="0,0,0,6" />

                    <!-- 2. Post-Sync Locked Banner (Visible when Synced) -->
                    <!-- Traceable to: ARCHITECTURE §4 TD-010, P4-S09 -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource Brush.Danger.Light}"
                            BorderBrush="{DynamicResource Brush.Danger.Border}"
                            BorderThickness="1" CornerRadius="4"
                            Padding="10,6" Margin="0,0,0,8">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelectedOrderSynced}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔒 " FontSize="12" Foreground="{DynamicResource Brush.Danger.Text}" VerticalAlignment="Center" />
                            <TextBlock Text="DOKUMEN TERKUNCI (READ-ONLY): Status telah disinkronkan ke pusat (Synced). Edit dan hapus dinonaktifkan."
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.Danger.Text}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- 3. Metadata Table (Responsive 4-column key-value grid) -->
                    <!-- Traceable to: ARCHITECTURE §4 TD-013 SCR-05 -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource Brush.Slate.50}"
                            BorderBrush="{DynamicResource Brush.Slate.200}"
                            BorderThickness="1" CornerRadius="4"
                            Padding="8,6" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="65" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" MinWidth="65" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Row 0: No ID & Status -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="No. ID:" FontSize="11.5" Foreground="{DynamicResource Brush.Slate.500}" Margin="0,2,6,2" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding OrderIdText}" FontFamily="Consolas" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource Brush.Slate.900}" Margin="0,2,10,2" />

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Status:" FontSize="11.5" Foreground="{DynamicResource Brush.Slate.500}" Margin="0,2,6,2" />
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding SyncStatusText}" FontWeight="Bold" FontSize="11.5" Margin="0,2,0,2">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Warning.Text}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSyncStatusSynced}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Success.Text}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Row 1: Customer & Tanggal -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Customer:" FontSize="11.5" Foreground="{DynamicResource Brush.Slate.500}" Margin="0,2,6,2" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CustomerText}" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource Brush.Slate.900}" Margin="0,2,10,2" TextTrimming="CharacterEllipsis" />

                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Tanggal:" FontSize="11.5" Foreground="{DynamicResource Brush.Slate.500}" Margin="0,2,6,2" />
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding DateText}" FontSize="11.5" Foreground="{DynamicResource Brush.Slate.700}" Margin="0,2,0,2" />

                            <!-- Row 2: Operator & Depo -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Operator:" FontSize="11.5" Foreground="{DynamicResource Brush.Slate.500}" Margin="0,2,6,2" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding OperatorText}" FontSize="11.5" Foreground="{DynamicResource Brush.Slate.700}" Margin="0,2,10,2" />

                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Depo:" FontSize="11.5" Foreground="{DynamicResource Brush.Slate.500}" Margin="0,2,6,2" />
                            <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding WarehouseText}" FontSize="11.5" Foreground="{DynamicResource Brush.Slate.700}" Margin="0,2,0,2" />

                            <!-- Row 3: Driver & Sales -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Driver:" FontSize="11.5" Foreground="{DynamicResource Brush.Slate.500}" Margin="0,2,6,2" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DriverText}" FontSize="11.5" Foreground="{DynamicResource Brush.Slate.700}" Margin="0,2,10,2" />

                            <TextBlock Grid.Row="3" Grid.Column="2" Text="Sales:" FontSize="11.5" Foreground="{DynamicResource Brush.Slate.500}" Margin="0,2,6,2" />
                            <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding SalesText}" FontSize="11.5" Foreground="{DynamicResource Brush.Slate.700}" Margin="0,2,0,2" />

                            <!-- Row 4: Catatan (Spans 3 cols) -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Catatan:" FontSize="11.5" Foreground="{DynamicResource Brush.Slate.500}" Margin="0,2,6,2" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding NoteText}" FontSize="11.5" Foreground="{DynamicResource Brush.Slate.600}" Margin="0,2,0,2" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>

                    <!-- 4. Detail Items Header -->
                    <TextBlock Grid.Row="3" Text="📦 Daftar Barang Fisik Retur:"
                               FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Slate.800}"
                               Margin="0,0,0,4" />

                    <!-- 5. Detail Items Grid -->
                    <DataGrid Grid.Row="4" x:Name="ItemsGrid"
                              ItemsSource="{Binding Items}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource Brush.Slate.200}"
                              BorderBrush="{DynamicResource Brush.Slate.200}"
                              BorderThickness="1"
                              Background="White"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              Margin="0,0,0,8">

                        <DataGrid.Columns>
                            <!-- No Urut -->
                            <DataGridTextColumn Header="#" Binding="{Binding NoUrut}" Width="35" />

                            <!-- Barang Name -->
                            <DataGridTextColumn Header="Barang" Binding="{Binding BrgName}" Width="*" />

                            <!-- Barcode -->
                            <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}"
                                                FontFamily="Consolas" Width="110" />

                            <!-- Klasifikasi (BAGUS / RUSAK badge) -->
                            <DataGridTemplateColumn Header="Klasifikasi" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="8" Padding="6,2"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="{x:Type Border}">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.Success.Light}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding JenisRetur}" Value="RUSAK">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.Danger.Light}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding JenisRetur}" FontSize="10.5" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="{x:Type TextBlock}">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Success.Text}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding JenisRetur}" Value="RUSAK">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Danger.Text}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Qty -->
                            <DataGridTextColumn Header="Qty"
                                                Binding="{Binding Qty, StringFormat=\{0:N0\}}"
                                                FontWeight="Bold"
                                                Width="55">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="Padding" Value="0,0,6,0" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Satuan -->
                            <DataGridTextColumn Header="Sat" Binding="{Binding SatId}" Width="45" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 6. Inspector Action Toolbar (Edit, Delete, Upload) -->
                    <!-- Traceable to: ARCHITECTURE §4 TD-010, TD-013, P4-S09 -->
                    <Border Grid.Row="5"
                            Background="{DynamicResource Brush.Slate.50}"
                            BorderBrush="{DynamicResource Brush.Slate.200}"
                            BorderThickness="1" CornerRadius="4"
                            Padding="8,6">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <!-- Edit Draft Button -->
                            <Button x:Name="EditButton"
                                    Command="{Binding EditDraftCommand}"
                                    IsEnabled="{Binding CanEditOrder}"
                                    Content="✏️ Buka / Edit Draft"
                                    Style="{StaticResource Button.Outline}"
                                    Height="28" MinHeight="28" Padding="10,2"
                                    Margin="0,0,8,0" />

                            <!-- Delete Draft Button -->
                            <Button x:Name="DeleteButton"
                                    Command="{Binding DeleteDraftCommand}"
                                    IsEnabled="{Binding CanDeleteOrder}"
                                    Content="🗑️ Hapus Draft"
                                    Style="{StaticResource Button.Danger}"
                                    Height="28" MinHeight="28" Padding="10,2"
                                    Margin="0,0,8,0" />

                            <!-- Upload Button (Cloud sync) -->
                            <Button x:Name="UploadButton"
                                    Command="{Binding UploadOrderCommand}"
                                    IsEnabled="{Binding CanUploadOrder}"
                                    Content="{Binding UploadButtonText}"
                                    Style="{StaticResource Button.Success}"
                                    Height="28" MinHeight="28" Padding="12,2" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
