<Window x:Class="BtrReturGudang.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:BtrReturGudang.Wpf.ViewModels"
        xmlns:views="clr-namespace:BtrReturGudang.Wpf.Views"
        mc:Ignorable="d"
        Title="BTR Retur Gudang - Desktop Application"
        Height="720" Width="1280"
        MinHeight="600" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Window.Background}"
        d:DataContext="{d:DesignInstance vm:MainViewModel}">

    <!-- ======================================================== -->
    <!-- GLOBAL WINDOW HOTKEYS (F1, F3, F4, F5, F9, F10, Esc)     -->
    <!-- Traceable to: ARCHITECTURE §4 TD-011, P2-S04             -->
    <!-- ======================================================== -->
    <Window.InputBindings>
        <KeyBinding Key="F1" Command="{Binding NavigateToIntakeCommand}" />
        <KeyBinding Key="F3" Command="{Binding NavigateToDaftarReturCommand}" />
        <KeyBinding Key="F4" Command="{Binding NavigateToBarcodeRegistryCommand}" />
        <KeyBinding Key="F5" Command="{Binding NavigateToSettingsCommand}" />
        <KeyBinding Key="F9" Command="{Binding SaveDraftCommand}" />
        <KeyBinding Key="F10" Command="{Binding SaveAndUploadCommand}" />
        <KeyBinding Key="Esc" Command="{Binding CancelOrClearCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <!-- Sidebar Navigation Button Base Template -->
        <ControlTemplate x:Key="SidebarNavButtonTemplate" TargetType="{x:Type Button}">
            <Border x:Name="border"
                    Background="{TemplateBinding Background}"
                    CornerRadius="4"
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="border" Property="Background" Value="{DynamicResource Brush.Slate.700}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.White}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Base Sidebar Nav Button Style -->
        <Style x:Key="Button.SidebarNav" TargetType="{x:Type Button}">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Slate.300}" />
            <Setter Property="Background" Value="{DynamicResource Brush.Sidebar.Background}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="8,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template" Value="{StaticResource SidebarNavButtonTemplate}" />
        </Style>

        <!-- Active Module Highlight Styles (Primary Blue when Active) -->
        <Style x:Key="Button.SidebarNav.Intake" TargetType="{x:Type Button}" BasedOn="{StaticResource Button.SidebarNav}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsIntakeActive}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Primary}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.White}" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Button.SidebarNav.DaftarRetur" TargetType="{x:Type Button}" BasedOn="{StaticResource Button.SidebarNav}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDaftarReturActive}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Primary}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.White}" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Button.SidebarNav.BarcodeRegistry" TargetType="{x:Type Button}" BasedOn="{StaticResource Button.SidebarNav}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBarcodeRegistryActive}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Primary}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.White}" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Button.SidebarNav.Pengaturan" TargetType="{x:Type Button}" BasedOn="{StaticResource Button.SidebarNav}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPengaturanActive}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Primary}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.White}" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Master Layout Grid (Header, Main Body, Status Bar) -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <!-- ======================================================== -->
        <!-- ROW 0: TOP HEADER (44px)                                  -->
        <!-- Brand, Depo Badge, Operator Badge, Switcher, Online Dot  -->
        <!-- Traceable to: ARCHITECTURE §4 TD-012, TD-013, SCR-01     -->
        <!-- ======================================================== -->
        <Border Grid.Row="0" Height="44" Background="{DynamicResource Brush.Slate.900}"
                BorderBrush="{DynamicResource Brush.Slate.800}" BorderThickness="0,0,0,1"
                Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Brand Logo & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource Brush.Primary}" CornerRadius="3" Width="36" Height="22" Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="BTR" Foreground="{DynamicResource Brush.White}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="RETUR GUDANG" Foreground="{DynamicResource Brush.White}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Right: Depo, Operator Badge, Switch Button, Online Pill -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Depo Badge -->
                    <Border Background="{DynamicResource Brush.Slate.800}" CornerRadius="4" Padding="8,4" Margin="0,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DepoBadgeText}" Foreground="{DynamicResource Brush.Slate.300}" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" />
                    </Border>

                    <!-- Operator Badge with Tooltip -->
                    <Border Background="{DynamicResource Brush.Slate.800}" CornerRadius="4" Padding="8,4" Margin="0,0,6,0" VerticalAlignment="Center"
                            ToolTip="{Binding OperatorEmailTooltip}">
                        <TextBlock Text="{Binding OperatorBadgeText}" Foreground="{DynamicResource Brush.White}" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" />
                    </Border>

                    <!-- Switch Operator Button -->
                    <Button Command="{Binding SwitchOperatorCommand}" Content="Ganti"
                            Background="{DynamicResource Brush.Slate.700}" Foreground="{DynamicResource Brush.Slate.300}"
                            FontSize="11" FontWeight="SemiBold" Height="26" MinHeight="26" Padding="8,2" Margin="0,0,12,0"
                            VerticalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource Brush.Slate.600}" />
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.White}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Online Status Pill -->
                    <Border CornerRadius="12" Padding="8,3,10,3" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Background" Value="#142820" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                        <Setter Property="Background" Value="#2A1618" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="{x:Type Ellipse}">
                                        <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                <Setter Property="Fill" Value="{DynamicResource Brush.Danger}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding OnlineStatusText}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================================================== -->
        <!-- ROW 1: MAIN BODY (Sidebar + Active View Content Host)     -->
        <!-- ======================================================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ======================================================== -->
            <!-- DOCKED LEFT NAVIGATION SIDEBAR (200px)                   -->
            <!-- Intake, Daftar Retur, Barcode Registry, Pengaturan, Sync -->
            <!-- ======================================================== -->
            <Border Grid.Column="0" Width="200"
                    Background="{DynamicResource Brush.Sidebar.Background}"
                    BorderBrush="{DynamicResource Brush.Slate.800}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Navigation Header -->
                    <TextBlock Grid.Row="0" Text="NAVIGASI UTAMA"
                               Foreground="{DynamicResource Brush.Slate.400}"
                               FontWeight="Bold" FontSize="10" Margin="14,14,14,8" />

                    <!-- Navigation Buttons -->
                    <StackPanel Grid.Row="1">
                        <Button x:Name="BtnNavIntake"
                                Content="  [F1]  Intake Retur"
                                Command="{Binding NavigateToIntakeCommand}"
                                Style="{StaticResource Button.SidebarNav.Intake}" />

                        <Button x:Name="BtnNavDaftar"
                                Content="  [F3]  Daftar Retur"
                                Command="{Binding NavigateToDaftarReturCommand}"
                                Style="{StaticResource Button.SidebarNav.DaftarRetur}" />

                        <Button x:Name="BtnNavBarcode"
                                Content="  [F4]  Barcode Registry"
                                Command="{Binding NavigateToBarcodeRegistryCommand}"
                                Style="{StaticResource Button.SidebarNav.BarcodeRegistry}" />

                        <Button x:Name="BtnNavSettings"
                                Content="  [F5]  Pengaturan"
                                Command="{Binding NavigateToSettingsCommand}"
                                Style="{StaticResource Button.SidebarNav.Pengaturan}" />
                    </StackPanel>

                    <!-- Bottom Sync Container -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,8">
                        <Button Command="{Binding ManualSyncCommand}"
                                Content="{Binding ManualSyncButtonText}"
                                Style="{DynamicResource Button.Success}"
                                Height="38" Margin="8,0,8,6"
                                FontSize="12" FontWeight="SemiBold" />

                        <TextBlock Text="{Binding SyncAnimationText}"
                                   Foreground="{DynamicResource Brush.Slate.400}"
                                   FontSize="10" HorizontalAlignment="Center" Margin="0,0,0,4" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ======================================================== -->
            <!-- ACTIVE CONTENT HOST (ContentControl)                     -->
            <!-- Displays the currently selected View / ViewModel         -->
            <!-- ======================================================== -->
            <Grid Grid.Column="1" Background="{DynamicResource Brush.Window.Background}">
                <ContentControl Content="{Binding CurrentViewModel}">
                    <ContentControl.Resources>
                        <DataTemplate DataType="{x:Type vm:ReturnOrderEntryViewModel}">
                            <views:ReturnOrderEntryView />
                        </DataTemplate>

                        <DataTemplate DataType="{x:Type vm:ReturnOrderListViewModel}">
                            <views:ReturnOrderListView />
                        </DataTemplate>

                        <DataTemplate DataType="{x:Type vm:BarcodeRegistryViewModel}">
                            <views:BarcodeRegistryView />
                        </DataTemplate>

                        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                            <views:SettingsView />
                        </DataTemplate>
                    </ContentControl.Resources>
                </ContentControl>
            </Grid>
        </Grid>

        <!-- ======================================================== -->
        <!-- ROW 2: BOTTOM STATUS BAR (26px)                           -->
        <!-- Scanner wedge status, latency, sync timestamp, info log  -->
        <!-- Traceable to: ARCHITECTURE §5.2 SCR-01                   -->
        <!-- ======================================================== -->
        <Border Grid.Row="2" Height="26" Background="{DynamicResource Brush.White}"
                BorderBrush="{DynamicResource Brush.Slate.300}" BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Scanner Status -->
                <TextBlock Grid.Column="0" Text="{Binding ScannerStatusText}"
                           FontWeight="SemiBold" Foreground="{DynamicResource Brush.Slate.900}"
                           VerticalAlignment="Center" FontSize="11.5" />
                <Rectangle Grid.Column="1" Width="1" Margin="10,4" Fill="{DynamicResource Brush.Slate.300}" />

                <!-- Latency -->
                <TextBlock Grid.Column="2" Text="{Binding LatencyStatusText}"
                           Foreground="{DynamicResource Brush.Slate.600}"
                           VerticalAlignment="Center" FontSize="11.5" />
                <Rectangle Grid.Column="3" Width="1" Margin="10,4" Fill="{DynamicResource Brush.Slate.300}" />

                <!-- Last Sync Status -->
                <TextBlock Grid.Column="4" Text="{Binding LastSyncStatusText}"
                           VerticalAlignment="Center" FontSize="11.5">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Slate.600}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LastSyncSuccess}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding LastSyncSuccess}" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Rectangle Grid.Column="5" Width="1" Margin="10,4" Fill="{DynamicResource Brush.Slate.300}" />

                <!-- Status Information Message -->
                <TextBlock Grid.Column="6" Text="{Binding StatusInfoText}"
                           Foreground="{DynamicResource Brush.Slate.500}"
                           VerticalAlignment="Center" FontSize="11.5"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
    </Grid>
</Window>
