<UserControl x:Class="BtrReturGudang.Wpf.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BtrReturGudang.Wpf.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
             Background="{DynamicResource Brush.Window.Background}"
             FontFamily="Segoe UI" FontSize="12">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Header (44px per TD-013) -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.White}"
                BorderBrush="{DynamicResource Brush.Card.Border}" BorderThickness="0,0,0,1"
                Padding="16,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Pengaturan Stasiun Kerja [F5]" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Brush.Slate.900}" />
                    <TextBlock Text="Konfigurasi identitas depo, koneksi database lokal (btrgd), relay Cloud API, dan feedback scanner."
                               FontSize="10" Foreground="{DynamicResource Brush.Slate.500}" />
                </StackPanel>

                <Button x:Name="BtnSaveAll" Grid.Column="1" Content="💾 Simpan Semua Pengaturan"
                        Command="{Binding SaveAllCommand}"
                        Background="{DynamicResource Brush.Primary}" Foreground="{DynamicResource Brush.White}"
                        FontWeight="Bold" Height="30" Padding="14,2" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- 2. Scrollable Cards Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,12">
            <StackPanel MaxWidth="960" HorizontalAlignment="Left">

                <!-- CARD 1: Identitas Workstation & Depo -->
                <Border Background="{DynamicResource Brush.White}"
                        BorderBrush="{DynamicResource Brush.Card.Border}" BorderThickness="1"
                        CornerRadius="6" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="🏢 Identitas Workstation &amp; Operator Gudang"
                                   FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Brush.Slate.900}" Margin="0,0,0,12" />

                        <!-- Row 1: Depo Code, Server Target ID, PC Name -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="200" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Kode Depo / Warehouse:" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Slate.700}" Margin="0,0,0,4" />
                                <TextBox x:Name="TxtWarehouseCode" Height="30" Padding="6,2"
                                         Text="{Binding WarehouseCode, UpdateSourceTrigger=PropertyChanged}"
                                         Background="{DynamicResource Brush.White}" BorderBrush="{DynamicResource Brush.Card.Border}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Server Target ID:" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Slate.700}" Margin="0,0,0,4" />
                                <TextBox x:Name="TxtServerTargetId" Height="30" Padding="6,2"
                                         Text="{Binding ServerTargetId, UpdateSourceTrigger=PropertyChanged}"
                                         Background="{DynamicResource Brush.White}" BorderBrush="{DynamicResource Brush.Card.Border}" />
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Nama Komputer (PC):" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Slate.700}" Margin="0,0,0,4" />
                                <TextBox x:Name="TxtPcName" Height="30" Padding="6,2"
                                         Text="{Binding PcName}" IsReadOnly="True"
                                         Background="{DynamicResource Brush.Slate.100}" BorderBrush="{DynamicResource Brush.Card.Border}" />
                            </StackPanel>
                        </Grid>

                        <!-- Row 2: Operator Identity & Switcher -->
                        <Border Background="{DynamicResource Brush.Slate.50}"
                                BorderBrush="{DynamicResource Brush.Card.Border}" BorderThickness="1"
                                CornerRadius="4" Padding="12" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="Operator Aktif: " FontWeight="SemiBold" Foreground="{DynamicResource Brush.Slate.700}" />
                                        <TextBlock x:Name="LblOperatorName" Text="{Binding OperatorName}" FontWeight="Bold" Foreground="{DynamicResource Brush.Slate.900}" Margin="0,0,12,0" />
                                        <TextBlock Text="Google Email: " FontWeight="SemiBold" Foreground="{DynamicResource Brush.Slate.700}" />
                                        <TextBlock x:Name="LblOperatorEmail" Text="{Binding OperatorEmail}" FontFamily="Consolas" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Primary}" />
                                    </StackPanel>

                                    <TextBlock x:Name="LblSessionStatus" Text="{Binding OperatorSessionStatus}"
                                               FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Slate.600}" />
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnSwitchOperator" Content="👤 Ganti Operator"
                                            Command="{Binding SwitchOperatorCommand}"
                                            Background="{DynamicResource Brush.Slate.700}" Foreground="{DynamicResource Brush.White}"
                                            FontWeight="SemiBold" Height="28" Padding="10,2" Margin="0,0,8,0" />

                                    <Button x:Name="BtnVerifyOperator" Content="🔍 Verifikasi"
                                            Command="{Binding VerifyOperatorCommand}"
                                            Background="{DynamicResource Brush.White}" Foreground="{DynamicResource Brush.Slate.800}"
                                            BorderBrush="{DynamicResource Brush.Card.Border}" BorderThickness="1"
                                            FontWeight="SemiBold" Height="28" Padding="10,2" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- CARD 2: Koneksi Database Lokal -->
                <Border Background="{DynamicResource Brush.White}"
                        BorderBrush="{DynamicResource Brush.Card.Border}" BorderThickness="1"
                        CornerRadius="6" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="🗄️ Koneksi Database Lokal (SQL Server btrgd)"
                                   FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Brush.Slate.900}" Margin="0,0,0,8" />

                        <TextBlock Text="Connection String:" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Slate.700}" Margin="0,0,0,4" />
                        <TextBox x:Name="TxtConnString" Height="30" Padding="6,2"
                                 Text="{Binding ConnectionString, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Consolas" FontSize="11"
                                 Background="{DynamicResource Brush.White}" BorderBrush="{DynamicResource Brush.Card.Border}" Margin="0,0,0,8" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Button x:Name="BtnTestDb" Content="🔌 Uji Koneksi Database"
                                    Command="{Binding TestDbCommand}"
                                    Background="{DynamicResource Brush.Slate.100}" Foreground="{DynamicResource Brush.Slate.800}"
                                    BorderBrush="{DynamicResource Brush.Card.Border}" BorderThickness="1"
                                    FontWeight="SemiBold" Height="28" Padding="12,2" Margin="0,0,8,0" />

                            <Button x:Name="BtnResetDb" Content="Reset Default"
                                    Command="{Binding ResetDbCommand}"
                                    Background="{DynamicResource Brush.White}" Foreground="{DynamicResource Brush.Slate.600}"
                                    BorderBrush="{DynamicResource Brush.Card.Border}" BorderThickness="1"
                                    Height="28" Padding="10,2" Margin="0,0,14,0" />

                            <TextBlock x:Name="LblDbStatus" Text="{Binding DbStatusMessage}"
                                       VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- CARD 3: Cloud API Relay -->
                <Border Background="{DynamicResource Brush.White}"
                        BorderBrush="{DynamicResource Brush.Card.Border}" BorderThickness="1"
                        CornerRadius="6" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="☁️ Cloud Staging Relay API (j06-pkl-btrade-api)"
                                   FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Brush.Slate.900}" Margin="0,0,0,8" />

                        <TextBlock Text="Base URL Endpoint:" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Slate.700}" Margin="0,0,0,4" />
                        <TextBox x:Name="TxtApiUrl" Height="30" Padding="6,2"
                                 Text="{Binding ApiBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Consolas" FontSize="11"
                                 Background="{DynamicResource Brush.White}" BorderBrush="{DynamicResource Brush.Card.Border}" Margin="0,0,0,8" />

                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnTestApi" Content="🌐 Uji Route HTTP API"
                                    Command="{Binding TestApiCommand}"
                                    Background="{DynamicResource Brush.Slate.100}" Foreground="{DynamicResource Brush.Slate.800}"
                                    BorderBrush="{DynamicResource Brush.Card.Border}" BorderThickness="1"
                                    FontWeight="SemiBold" Height="28" Padding="12,2" Margin="0,0,14,0" />

                            <TextBlock x:Name="LblApiStatus" Text="{Binding ApiStatusMessage}"
                                       VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- CARD 4: Audio Feedback Scanner -->
                <Border Background="{DynamicResource Brush.White}"
                        BorderBrush="{DynamicResource Brush.Card.Border}" BorderThickness="1"
                        CornerRadius="6" Padding="16" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="🔊 Audio Feedback Hardware Scanner"
                                   FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Brush.Slate.900}" Margin="0,0,0,10" />

                        <CheckBox x:Name="ChkEnableAudio" Content="Aktifkan Bunyi Beeper Audio Scanner (Multimedia Beeps)"
                                  IsChecked="{Binding EnableSoundFeedback}"
                                  FontWeight="SemiBold" Foreground="{DynamicResource Brush.Slate.800}" Margin="0,0,0,12" />

                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnTestSuccessBeep" Content="🔔 Uji Beep Sukses (2000 Hz)"
                                    Command="{Binding TestSuccessBeepCommand}"
                                    Background="{DynamicResource Brush.White}" Foreground="#047857"
                                    BorderBrush="#A7F3D0" BorderThickness="1"
                                    FontWeight="SemiBold" Height="28" Padding="12,2" Margin="0,0,10,0" />

                            <Button x:Name="BtnTestWarningBeep" Content="⚠️ Uji Beep Peringatan (400 Hz)"
                                    Command="{Binding TestWarningBeepCommand}"
                                    Background="{DynamicResource Brush.White}" Foreground="#B45309"
                                    BorderBrush="#FDE68A" BorderThickness="1"
                                    FontWeight="SemiBold" Height="28" Padding="12,2" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 3. Footer Status Notification Strip -->
        <Border Grid.Row="2" Background="{DynamicResource Brush.Slate.100}"
                BorderBrush="{DynamicResource Brush.Card.Border}" BorderThickness="0,1,0,0"
                Padding="16,6">
            <TextBlock x:Name="LblStatusMessage" Text="{Binding StatusMessage}"
                       FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource Brush.Slate.700}" />
        </Border>
    </Grid>
</UserControl>
