<UserControl x:Class="BtrReturGudang.Wpf.Views.BarcodeRegistryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BtrReturGudang.Wpf.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:BarcodeRegistryViewModel}"
             Background="{DynamicResource Brush.Window.Background}"
             FontFamily="Segoe UI" FontSize="12">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Header (44px per TD-013) -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.White}"
                BorderBrush="{DynamicResource Brush.Card.Border}" BorderThickness="0,0,0,1"
                Padding="16,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Barcode Registry [F4]" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Brush.Slate.900}" />
                    <TextBlock Text="Katalog barcode fisik lokal, status sinkronisasi, dan registrasi on-the-spot."
                               FontSize="10" Foreground="{DynamicResource Brush.Slate.500}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnAddBarcode" Content="➕ Tambah Barcode Baru"
                            Command="{Binding AddBarcodeCommand}"
                            Background="{DynamicResource Brush.Primary}" Foreground="{DynamicResource Brush.White}"
                            FontWeight="SemiBold" Height="30" Padding="12,2" Margin="0,0,8,0" />

                    <Button x:Name="BtnRefresh" Content="🔄 Refresh"
                            Command="{Binding RefreshCommand}"
                            Background="{DynamicResource Brush.Slate.100}" Foreground="{DynamicResource Brush.Slate.700}"
                            BorderBrush="{DynamicResource Brush.Card.Border}" BorderThickness="1"
                            FontWeight="SemiBold" Height="30" Padding="12,2" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Search & Filter Bar (42px) -->
        <Border Grid.Row="1" Background="{DynamicResource Brush.Slate.50}"
                BorderBrush="{DynamicResource Brush.Card.Border}" BorderThickness="0,0,0,1"
                Padding="16,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Search Input -->
                <TextBlock Grid.Column="0" Text="Cari:" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Slate.700}"
                           VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox x:Name="TxtSearch" Grid.Column="1" Height="28" Padding="6,2"
                         Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center" Background="{DynamicResource Brush.White}"
                         BorderBrush="{DynamicResource Brush.Card.Border}" Margin="0,0,16,0" />

                <!-- Status Filter -->
                <TextBlock Grid.Column="2" Text="Status:" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Slate.700}"
                           VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox x:Name="CboStatusFilter" Grid.Column="3" Height="28"
                          ItemsSource="{Binding StatusFilterOptions}"
                          SelectedItem="{Binding SelectedStatusFilter}"
                          VerticalContentAlignment="Center" Margin="0,0,16,0" />

                <!-- Status / Item Count -->
                <TextBlock Grid.Column="4" Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource Brush.Slate.500}" FontSize="11"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                <!-- Pagination Strip -->
                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PageSummary}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Slate.600}" VerticalAlignment="Center" Margin="0,0,10,0" />

                    <Button x:Name="BtnPrevPage" Content="◀"
                            Command="{Binding PreviousPageCommand}"
                            Width="28" Height="26" Margin="0,0,4,0"
                            Background="{DynamicResource Brush.White}" BorderBrush="{DynamicResource Brush.Card.Border}"
                            BorderThickness="1" ToolTip="Halaman Sebelumnya" />

                    <Button x:Name="BtnNextPage" Content="▶"
                            Command="{Binding NextPageCommand}"
                            Width="28" Height="26"
                            Background="{DynamicResource Brush.White}" BorderBrush="{DynamicResource Brush.Card.Border}"
                            BorderThickness="1" ToolTip="Halaman Berikutnya" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. Barcodes DataGrid -->
        <Border Grid.Row="2" Padding="16,10">
            <Border Background="{DynamicResource Brush.White}"
                    BorderBrush="{DynamicResource Brush.Card.Border}" BorderThickness="1" CornerRadius="4">
                <DataGrid x:Name="DgvBarcodes"
                          ItemsSource="{Binding PagedItems}"
                          SelectedItem="{Binding SelectedBarcode}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{DynamicResource Brush.Slate.200}"
                          Background="{DynamicResource Brush.White}"
                          RowHeight="32">
                    <DataGrid.Columns>
                        <!-- Barcode Value -->
                        <DataGridTextColumn Header="Nilai Barcode" Binding="{Binding Barcode}" Width="180">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="FontFamily" Value="Consolas" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="Padding" Value="8,0" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Product Code -->
                        <DataGridTextColumn Header="Kode Barang" Binding="{Binding BrgId}" Width="130">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="FontFamily" Value="Consolas" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="Padding" Value="8,0" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Product Name -->
                        <DataGridTextColumn Header="Nama Barang Master" Binding="{Binding BrgName}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="Padding" Value="8,0" />
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Satuan -->
                        <DataGridTextColumn Header="Satuan" Binding="{Binding Satuan}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Pengali -->
                        <DataGridTextColumn Header="Pengali" Binding="{Binding Pengali, StringFormat={}{0:N0}}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Padding" Value="0,0,8,0" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Status Badge Column -->
                        <DataGridTemplateColumn Header="Status Barcode" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="3" Padding="8,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="{x:Type Border}">
                                                <Setter Property="Background" Value="#D1FAE5" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPending}" Value="True">
                                                        <Setter Property="Background" Value="#FEF3C7" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Status}" FontWeight="Bold" FontSize="11">
                                            <TextBlock.Style>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="Foreground" Value="#047857" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPending}" Value="True">
                                                            <Setter Property="Foreground" Value="#B45309" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Action Column (Delete) -->
                        <DataGridTemplateColumn Header="Aksi" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Hapus"
                                            Command="{Binding DataContext.DeleteBarcodeCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}"
                                            Background="{DynamicResource Brush.Danger}"
                                            Foreground="{DynamicResource Brush.White}"
                                            FontSize="11" FontWeight="SemiBold"
                                            Height="24" Width="60"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Button.Template>
                                            <ControlTemplate TargetType="{x:Type Button}">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="3">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Border>

        <!-- 4. Footer Info Strip -->
        <Border Grid.Row="3" Background="{DynamicResource Brush.Slate.100}"
                BorderBrush="{DynamicResource Brush.Card.Border}" BorderThickness="0,1,0,0"
                Padding="16,4">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Total Barcode: " FontSize="11" Foreground="{DynamicResource Brush.Slate.600}" />
                <TextBlock Text="{Binding TotalItemsCount}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource Brush.Slate.800}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
