<Window x:Class="BtrReturGudang.Wpf.Views.BarcodeRegistrationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:BtrReturGudang.Wpf.Controls"
        mc:Ignorable="d"
        Title="Pendaftaran Barcode Baru"
        Width="580" Height="480"
        MinWidth="580" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource Brush.Window.Background}"
        FontFamily="Segoe UI" FontSize="12">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Header Banner (44px) -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Slate.900}" Padding="16,6">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="🏷️ Registrasi Barcode Produk" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Brush.White}" />
                <TextBlock Text="Tautkan barcode ke master barang dan tentukan satuan konversinya." FontSize="10" Foreground="{DynamicResource Brush.Slate.400}" />
            </StackPanel>
        </Border>

        <!-- 2. Form Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,10">
            <StackPanel>
                <!-- Barcode Value -->
                <TextBlock Text="Nilai Barcode:" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Slate.700}" Margin="0,0,0,4" />
                <TextBox x:Name="TxtBarcode" Height="32" Padding="6,4"
                         FontFamily="Consolas" FontSize="13" FontWeight="Bold"
                         Background="{DynamicResource Brush.White}"
                         BorderBrush="{DynamicResource Brush.Card.Border}"
                         Margin="0,0,0,10" />

                <!-- Product Lookup -->
                <TextBlock Text="Cari Master Barang (Nama / Kode):" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Slate.700}" Margin="0,0,0,4" />
                <TextBox x:Name="TxtSearchItem" Height="30" Padding="6,4"
                         Background="{DynamicResource Brush.White}"
                         BorderBrush="{DynamicResource Brush.Card.Border}"
                         TextChanged="OnSearchTextChanged"
                         Margin="0,0,0,6" />

                <ListBox x:Name="LstItems" Height="110"
                         BorderBrush="{DynamicResource Brush.Card.Border}"
                         SelectionChanged="OnItemSelected"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Margin="0,0,0,8">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="2">
                                <TextBlock Text="{Binding BrgId}" FontWeight="Bold" Width="100" FontFamily="Consolas" />
                                <TextBlock Text="{Binding BrgName}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="TxtSelectedItem" Text="Barang Terpilih: (Belum dipilih)"
                           FontWeight="Bold" Foreground="{DynamicResource Brush.Primary}"
                           Margin="0,0,0,10" />

                <!-- Unit & Multiplier Strip -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Satuan:" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Slate.700}" Margin="0,0,0,4" />
                        <ComboBox x:Name="CboSatuan" Height="30" SelectedIndex="0">
                            <ComboBoxItem Content="Dus" />
                            <ComboBoxItem Content="Pak" />
                            <ComboBoxItem Content="Pcs" />
                            <ComboBoxItem Content="Ball" />
                            <ComboBoxItem Content="Lusin" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Pengali (Konversi ke Pcs):" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Slate.700}" Margin="0,0,0,4" />
                        <TextBox x:Name="TxtPengali" Text="1" Height="30" Padding="6,4"
                                 FontWeight="Bold" TextAlignment="Right"
                                 BorderBrush="{DynamicResource Brush.Card.Border}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- 3. Footer Action Buttons -->
        <Border Grid.Row="2" Background="{DynamicResource Brush.White}"
                BorderBrush="{DynamicResource Brush.Card.Border}" BorderThickness="0,1,0,0"
                Padding="16,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnSave" Content="Simpan &amp; Daftarkan"
                        Width="150" Height="32" Margin="0,0,8,0"
                        Background="{DynamicResource Brush.Primary}"
                        Foreground="{DynamicResource Brush.White}"
                        FontWeight="Bold" Click="OnSaveClick" />

                <Button x:Name="BtnCancel" Content="Batal"
                        Width="90" Height="32"
                        Background="{DynamicResource Brush.White}"
                        Foreground="{DynamicResource Brush.Slate.700}"
                        BorderBrush="{DynamicResource Brush.Card.Border}"
                        BorderThickness="1" Click="OnCancelClick" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
