<Window x:Class="BtrReturGudang.Wpf.Views.ManualCustomerSearchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:BtrReturGudang.Wpf.ViewModels"
        mc:Ignorable="d"
        Title="Pencarian Master Customer"
        Width="760" Height="480"
        MinWidth="700" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource Brush.Window.Background}"
        FontFamily="Segoe UI" FontSize="12"
        d:DataContext="{d:DesignInstance vm:ManualCustomerSearchViewModel}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BtrReturGudang.Wpf;component/Themes/Colors.xaml" />
                <ResourceDictionary Source="/BtrReturGudang.Wpf;component/Themes/Styles.xaml" />
                <ResourceDictionary Source="/BtrReturGudang.Wpf;component/Themes/DataGrid.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Header Banner (44px) -->
            <RowDefinition Height="44" />
            <!-- 1: Search Filter Strip (~52px) -->
            <RowDefinition Height="Auto" />
            <!-- 2: Customer DataGrid (*) -->
            <RowDefinition Height="*" />
            <!-- 3: Footer Selected Summary & Actions (~64px) -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ======================================================== -->
        <!-- ROW 0: HEADER BANNER (44px)                              -->
        <!-- Traceable to: ARCHITECTURE §4 TD-013, §5.2 SCR-08        -->
        <!-- ======================================================== -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Slate.900}" Padding="16,6">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="🔍 Cari Master Customer (SCR-08)"
                           FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Brush.White}" />
                <TextBlock Text="Ketik nama, kode, atau alamat customer. Gunakan panah Atas/Bawah dan tekan Enter untuk memilih."
                           FontSize="10" Foreground="{DynamicResource Brush.Slate.400}" />
            </StackPanel>
        </Border>

        <!-- ======================================================== -->
        <!-- ROW 1: SEARCH FILTER STRIP                               -->
        <!-- ======================================================== -->
        <Border Grid.Row="1"
                Background="{DynamicResource Brush.Slate.50}"
                BorderBrush="{DynamicResource Brush.Card.Border}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Cari Customer:"
                           Style="{StaticResource Text.Label}"
                           VerticalAlignment="Center" Margin="0,0,10,0" />

                <TextBox Grid.Column="1" x:Name="TxtSearch"
                         Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                         Height="32" Padding="8,4" FontSize="13"
                         VerticalContentAlignment="Center"
                         Background="{DynamicResource Brush.White}"
                         BorderBrush="{DynamicResource Brush.Card.Border}"
                         ToolTip="Cari customer berdasarkan nama, kode, alamat, atau wilayah" />

                <Button Grid.Column="3" x:Name="BtnSearch"
                        Content="🔍 Cari"
                        Command="{Binding SearchCommand}"
                        Width="80" Height="32"
                        Style="{StaticResource Button.Primary}"
                        Cursor="Hand" />

                <Button Grid.Column="5" x:Name="BtnWalkInTop"
                        Content="🚶 Walk-in (F6)"
                        Command="{Binding SelectWalkInCustomerCommand}"
                        Height="32" Padding="10,0"
                        Style="{StaticResource Button.Secondary}"
                        ToolTip="Gunakan teks pencarian sebagai Walk-in Customer (CUST-MANUAL) tanpa lookup master"
                        Cursor="Hand" />
            </Grid>
        </Border>

        <!-- ======================================================== -->
        <!-- ROW 2: CUSTOMERS DATAGRID                                -->
        <!-- ======================================================== -->
        <Border Grid.Row="2" Background="{DynamicResource Brush.White}" Padding="12,8">
            <DataGrid x:Name="DgvCustomers"
                      ItemsSource="{Binding Customers}"
                      SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}"
                      SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                      Style="{StaticResource {x:Type DataGrid}}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      RowHeaderWidth="0"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <!-- Column 1: Customer Code (Monospace) -->
                    <DataGridTextColumn Header="Kode"
                                        Binding="{Binding CustomerCode}"
                                        Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="Consolas" />
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Slate.800}" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Padding" Value="6,0" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Column 2: Customer Name (Bold / Expanding) -->
                    <DataGridTextColumn Header="Nama Customer"
                                        Binding="{Binding CustomerName}"
                                        Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Slate.900}" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Padding" Value="6,0" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Column 3: Wilayah / Kota -->
                    <DataGridTextColumn Header="Wilayah / Kota"
                                        Binding="{Binding Wilayah}"
                                        Width="140">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Slate.700}" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Padding" Value="6,0" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Column 4: Alamat -->
                    <DataGridTextColumn Header="Alamat"
                                        Binding="{Binding Alamat}"
                                        Width="220">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Slate.600}" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                <Setter Property="Padding" Value="6,0" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ======================================================== -->
        <!-- ROW 3: FOOTER SELECTED SUMMARY & ACTION BUTTONS          -->
        <!-- ======================================================== -->
        <Border Grid.Row="3"
                Background="{DynamicResource Brush.Slate.50}"
                BorderBrush="{DynamicResource Brush.Card.Border}"
                BorderThickness="0,1,0,0"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Selected Customer & Result Count -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="LblSelectedCustomer"
                               Text="{Binding SelectedCustomerDisplayText}"
                               FontWeight="Bold" FontSize="12.5"
                               Foreground="{DynamicResource Brush.Primary}" />
                    <TextBlock x:Name="LblStatus"
                               Text="{Binding StatusText}"
                               FontSize="11" Foreground="{DynamicResource Brush.Slate.500}"
                               Margin="0,2,0,0" />
                </StackPanel>

                <!-- Right: Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnWalkInBottom"
                            Content="🚶 Walk-in (F6)"
                            Command="{Binding SelectWalkInCustomerCommand}"
                            Height="34" Padding="12,0" Margin="0,0,8,0"
                            Style="{StaticResource Button.Secondary}"
                            Cursor="Hand" />

                    <Button x:Name="BtnSelect"
                            Content="Pilih [Enter]"
                            Command="{Binding ConfirmSelectionCommand}"
                            Width="110" Height="34" Margin="0,0,8,0"
                            Style="{StaticResource Button.Primary}"
                            FontWeight="Bold" Cursor="Hand" />

                    <Button x:Name="BtnCancel"
                            Content="Batal [Esc]"
                            Command="{Binding CancelCommand}"
                            Width="90" Height="34"
                            Style="{StaticResource Button.Secondary}"
                            Cursor="Hand" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
