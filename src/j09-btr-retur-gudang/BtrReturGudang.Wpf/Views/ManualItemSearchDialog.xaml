<Window x:Class="BtrReturGudang.Wpf.Views.ManualItemSearchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Pencarian Barang Manual (F2)"
        Width="740" Height="480"
        MinWidth="740" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource Brush.Window.Background}"
        FontFamily="Segoe UI" FontSize="12">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Header Banner (44px) -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Slate.900}" Padding="20,6">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="🔍 Cari Master Barang" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Brush.White}" />
                <TextBlock Text="Ketik kode atau nama barang. Gunakan panah Atas/Bawah dan tekan Enter untuk memilih."
                           FontSize="10" Foreground="{DynamicResource Brush.Slate.400}" />
            </StackPanel>
        </Border>

        <!-- 2. Search Input Strip -->
        <Border Grid.Row="1" Background="{DynamicResource Brush.Slate.50}"
                BorderBrush="{DynamicResource Brush.Card.Border}" BorderThickness="0,0,0,1"
                Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Cari Barang:" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Slate.700}"
                           VerticalAlignment="Center" Margin="0,0,12,0" />

                <TextBox x:Name="TxtSearch" Grid.Column="1" Height="32" Padding="8,5"
                         FontSize="13" Background="{DynamicResource Brush.White}"
                         BorderBrush="{DynamicResource Brush.Card.Border}"
                         Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                         PreviewKeyDown="OnSearchPreviewKeyDown" />

                <Button x:Name="BtnSearch" Grid.Column="3" Content="Cari"
                        Width="90" Height="32"
                        Background="{DynamicResource Brush.Primary}"
                        Foreground="{DynamicResource Brush.White}"
                        FontWeight="SemiBold"
                        Command="{Binding SearchCommand}" />
            </Grid>
        </Border>

        <!-- 3. Master Items Grid -->
        <Border Grid.Row="2" Background="{DynamicResource Brush.White}" Padding="12,8">
            <DataGrid x:Name="DgvItems"
                      ItemsSource="{Binding FilteredItems}"
                      SelectedItem="{Binding SelectedBarang, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{DynamicResource Brush.Card.Border}"
                      BorderBrush="{DynamicResource Brush.Card.Border}"
                      BorderThickness="1"
                      RowHeaderWidth="0"
                      Background="{DynamicResource Brush.White}"
                      MouseDoubleClick="OnGridMouseDoubleClick"
                      PreviewKeyDown="OnGridPreviewKeyDown">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Kode Barang" Binding="{Binding BrgId}" Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="Consolas" />
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Slate.900}" />
                                <Setter Property="Padding" Value="6,4" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Nama Barang" Binding="{Binding BrgName}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Slate.800}" />
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                <Setter Property="Padding" Value="6,4" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Satuan 1" Binding="{Binding Satuan1}" Width="75">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Slate.600}" />
                                <Setter Property="Padding" Value="6,4" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Satuan 2" Binding="{Binding Satuan2}" Width="75">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Slate.500}" />
                                <Setter Property="Padding" Value="6,4" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Satuan 3" Binding="{Binding Satuan3}" Width="75">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Slate.500}" />
                                <Setter Property="Padding" Value="6,4" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 4. Footer Strip (Unit selector + Selection details + Action buttons) -->
        <Border Grid.Row="3" Background="{DynamicResource Brush.Slate.50}"
                BorderBrush="{DynamicResource Brush.Card.Border}" BorderThickness="0,1,0,0"
                Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left Details & Unit Selection -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtSelectedItem" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Primary}" FontSize="12" Margin="0,0,0,4">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Barang Terpilih: (Belum dipilih)" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedBarang, Converter={x:Null}}" Value="{x:Null}">
                                        <Setter Property="Text" Value="Barang Terpilih: (Belum dipilih)" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Satuan Kemasan:" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Slate.700}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />

                        <ComboBox x:Name="CboSatuan" Width="110" Height="28"
                                  ItemsSource="{Binding PackagingUnits}"
                                  SelectedItem="{Binding SelectedSatuan, Mode=TwoWay}" />

                        <TextBlock x:Name="LblStatus" Text="{Binding StatusText}"
                                   Foreground="{DynamicResource Brush.Slate.500}"
                                   FontSize="11" VerticalAlignment="Center" Margin="14,0,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Right Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnSelect" Content="Pilih (Enter)"
                            Width="115" Height="34" Margin="0,0,8,0"
                            Background="{DynamicResource Brush.Success}"
                            Foreground="{DynamicResource Brush.White}"
                            FontWeight="Bold"
                            Command="{Binding SelectCommand}"
                            Click="OnSelectClick" />

                    <Button x:Name="BtnCancel" Content="Batal (Esc)"
                            Width="90" Height="34"
                            Background="{DynamicResource Brush.White}"
                            Foreground="{DynamicResource Brush.Slate.700}"
                            BorderBrush="{DynamicResource Brush.Card.Border}"
                            BorderThickness="1"
                            Command="{Binding CancelCommand}"
                            Click="OnCancelClick" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
