<?xml version="1.0" encoding="utf-8"?>
<!--
    The default API base URL is HTTPS, so cleartext is only needed to keep manually
    configured http:// endpoints (Login -> API Base URL) usable on older servers.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">dev.smart-ics.com</domain>
    </domain-config>
</network-security-config>